#include <windows.h>

IDI_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/res/HwWidget.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_COMMA@
 PRODUCTVERSION @APP_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "hw-widget"
            VALUE "FileDescription", "HUAWEI WiFi Widget (Qt)"
            VALUE "FileVersion", "@APP_VERSION@"
            VALUE "InternalName", "HwWidgetQt"
            VALUE "OriginalFilename", "HwWidgetQt.exe"
            VALUE "ProductName", "HUAWEI WiFi Widget"
            VALUE "ProductVersion", "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END